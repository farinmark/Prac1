------------------------------------------------------------
# LSBATCH: User input
#!/bin/bash
#BSUB -J p13_omp_400
#BSUB -n 1
#BSUB -W 00:15
#BSUB -R "affinity[core(16)]"
#BSUB -o omp_400.%J.out
#BSUB -e omp_400.%J.err
# Серия omp_400: 1 прогрев (repeat 0) + 3 повтора на каждую конфигурацию.
export OMP_PROC_BIND=close OMP_PLACES=cores
echo "host=$(hostname) LSB_JOBID=$LSB_JOBID cpus=$(taskset -pc $$ | sed 's/.*: //')"
for t in 2 4 8 16; do
    for r in 0 1 2 3; do
        echo "### grid=400x600 threads=$t repeat=$r"
        OMP_NUM_THREADS=$t ./bin/poisson_omp -M 400 -N 600
    done
done


