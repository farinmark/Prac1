------------------------------------------------------------
# LSBATCH: User input
#!/bin/bash
#BSUB -J p13_omp_800
#BSUB -n 1
#BSUB -W 00:30
#BSUB -R "affinity[core(16)]"
#BSUB -o omp_800.%J.out
#BSUB -e omp_800.%J.err
# Серия omp_800: 1 прогрев (repeat 0) + 3 повтора на каждую конфигурацию.
export OMP_PROC_BIND=close OMP_PLACES=cores
echo "host=$(hostname) LSB_JOBID=$LSB_JOBID cpus=$(taskset -pc $$ | sed 's/.*: //')"
# 32 нити -- на 16 ядрах по 2 аппаратных потока (SMT), т.к. в узле 20 физ. ядер
for t in 4 8 16 32; do
    for r in 0 1 2 3; do
        echo "### grid=800x1200 threads=$t repeat=$r"
        OMP_NUM_THREADS=$t ./bin/poisson_omp -M 800 -N 1200
    done
done


